# Copy to .deploy.env (gitignored) for local/WSL deploys.
# GitHub Actions uses the same names as Environment secrets/variables
# (Settings → Environments → `.deploy.env`).

# SSH login — must match the account whose authorized_keys has DEPLOY_SSH_KEY.
DEPLOY_HOST=
DEPLOY_USER=root
DEPLOY_PORT=22
DEPLOY_PATH=/www/wwwroot/pay.example.com
# WSL: path ke private key yang public-nya sudah di authorized_keys root VPS
DEPLOY_SSH_KEY=~/.ssh/kasq_deploy

# OS user yang menjalankan PM2 (non-root). SSH tetap sebagai root untuk rsync/chown.
DEPLOY_APP_USER=dianrp
DEPLOY_PM2_NAME=drp-payment
